<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Ficha Técnica - MINAGUAS / HIDROCARIBE</title>
    <style>
        /* CONFIGURACIÓN DE PÁGINA IMPRESA (A4 Horizontal con márgenes limpios) */
        @page {
            size: A4 landscape;
            margin: 10mm;
        }
        * {
            box-sizing: border-box;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }
        body {
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #ffffff;
            color: #1e293b;
        }

        /* Contenedor por cada hoja para salto de página limpio */
        .page-station {
            page-break-after: always;
            width: 100%;
            /* EL GRAN RECUADRO EXTERIOR ÚNICO QUE UNE TODO EL REPORTE */
            border: 2px solid #005088; 
            display: flex;
            flex-direction: column;
        }
        .page-station:last-child {
            page-break-after: avoid;
        }

        /* --- ESTILOS DEL ENCABEZADO --- */
        .header-table {
            width: 100%;
            border-collapse: collapse;
            border-bottom: 2px solid #005088;
        }
        .header-table td {
            padding: 8px;
            vertical-align: middle;
            border: 1px solid #cbd5e1;
        }
        .head-govt-row {
            text-align: center;
            background-color: #ffffff;
            padding: 5px !important;
        }
        .head-govt-row img {
            height: 45px; 
            width: auto; 
            object-fit: contain;
        }
        .head-minaguas-cell {
            width: 20%;
            text-align: center;
        }
        .head-minaguas-cell img {
            height: 60px;
            width: auto;
            object-fit: contain;
        }
        .head-title-cell {
            width: 55%;
            text-align: center;
            font-weight: bold;
            font-size: 11pt;
            color: #005088;
            text-transform: uppercase;
        }
        .station-label {
            font-size: 8pt;
            color: #64748b;
            font-weight: normal;
        }
        .head-meta-cell {
            width: 25%;
            padding: 0 !important;
        }
        .meta-subtable {
            width: 100%;
            border-collapse: collapse;
        }
        .meta-subtable td {
            border: none !important;
            border-bottom: 1px solid #cbd5e1 !important;
            padding: 4px 8px !important;
            font-size: 8pt !important;
        }
        .meta-subtable tr:last-child td { border-bottom: none !important; }
        .lbl-meta { font-weight: bold; color: #005088; text-transform: uppercase; }
        .val-meta { font-weight: bold; color: #334155; }

        /* --- ESTILOS DEL CUERPO TÉCNICO --- */
        .data-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }
        .data-table td {
            border: 1.5px solid #005088;
            padding: 8px 12px; /* Reducido levemente para que quepan 20 items */
            font-size: 9.5pt;
            vertical-align: middle;
            word-wrap: break-word;
        }
        .lbl-tech {
            background-color: #005088;
            color: #ffffff;
            font-weight: bold;
            text-transform: uppercase;
            font-size: 8.5pt;
            letter-spacing: 0.3px;
        }
        .val-tech {
            background-color: #ffffff;
            font-weight: 600;
            color: #1e293b;
        }
        .section-divider {
            background-color: #11caa0;
            color: #ffffff;
            font-weight: bold;
            text-transform: uppercase;
            text-align: center;
            font-size: 10.5pt;
            letter-spacing: 1px;
            padding: 5px !important;
        }

        /* FORMATOS CONDICIONALES / ESTADOS */
        .status-positive { color: #10b981; font-weight: bold; }
        .status-highlight { color: #005088; font-weight: bold; }

        /* Clases utilitarias de alineación */
        .text-center { text-align: center; }
        .text-right { text-align: right; }
        
        .footer-note {
            margin-top: auto;
            border-top: 1px solid #cbd5e1;
            padding: 6px 10px;
            display: flex;
            justify-content: space-between;
            font-size: 7.5pt;
            color: #94a3b8;
            font-style: italic;
            background-color: #f8fafc;
        }
    </style>
</head>
<body>

    <% 
        const renderHeader = (paginaNum, totalPaginas) => `
        <table class="header-table">
            <tr>
                
                <td colspan="3" class="head-govt-row">
                    ${logoGobierno ? `<img src="${logoGobierno}" alt="Gobierno">` : ''}
                </td>
            </tr>
            <tr>
                <td class="head-minaguas-cell">
                    ${logoMinaguas ? `<img src="${logoMinaguas}" alt="MinAguas">` : ''}
                </td>
                <td class="head-title-cell">
                    <span class="station-label">ESTACIÓN DE BOMBEO:</span><br>
                    ${data.estacion.nombre_est}, EDO. NUEVA ESPARTA
                </td>
                <td class="head-meta-cell">
                    <table class="meta-subtable">
                        <tr>
                            <td class="lbl-meta">Código:</td>
                            <td class="val-meta text-right" style="color: #11caa0;">${data.estacion.codigo || 'N/A'}</td>
                        </tr>
                        <tr>
                            <td class="lbl-meta">Hidrológica:</td>
                            <td class="val-meta text-right">HIDROCARIBE</td>
                        </tr>
                        <tr>
                            <td class="lbl-meta">Sección:</td>
                            <td class="val-meta text-right">${paginaNum} de ${totalPaginas}</td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
        `;
    %>

    <div class="page-station">
        <%- renderHeader(1, 8) %>
        <table class="data-table">

            <colgroup>
                <col style="width: 25%;">
                <col style="width: 25%;">
                <col style="width: 25%;">
                <col style="width: 25%;">
            </colgroup>

            <tr>
                <td class="lbl-tech">NOMBRE DEL SISTEMA</td>
                <td colspan="3" class="val-tech status-highlight" style="font-size: 10.5pt;">
                    <%=data.estacion.nombre_sistema || 'N/A'%>
                </td>
            </tr>
            <tr>
                <td class="lbl-tech">NOMBRE DE LA ESTACIÓN DE BOMBEO</td>
                <td colspan="3" class="val-tech" style="font-size: 10.5pt;"><%=data.estacion.nombre_est || 'N/A'%></td>
            </tr>
            <tr>
                <td class="lbl-tech">TIPO DE ESTACIÓN DE BOMBEO:</td>
                <td class="val-tech text-center"><%= data.estacion.tipo_est || 'NO ESPECIFICADO' %></td>
                <td class="lbl-tech">TIPO DE SUCCIÓN:</td>
                <td class="val-tech text-center">
                <% if (data.estacion.tipo_succion === 1) { %> 
                    <span class="status-positive">POSITIVA (Tanque)</span> 
                <% } else if (data.estacion.tipo_succion === 0) { %> 
                    <span style="color:#ef4444; font-weight:bold;">NEGATIVA</span> 
                <% } else { %> 
                    <span style="color:#94a3b8;">-</span> 
                <% } %>
                </td>
            </tr>

            <tr>
                <td colspan="4" class="section-divider">IDENTIFICACIÓN Y GEOLOCALIZACIÓN</td>
            </tr>
            <tr>
                <td class="lbl-tech">UBICACIÓN / LOCALIDAD:</td>
                <td class="val-tech" style="font-size: 8.5pt;"><%= data.estacion.ubicacion || 'N/A' %></td>
                <td class="lbl-tech">COORDENADAS (UTM):</td>
                <td class="val-tech" style="font-family: monospace; font-size: 9pt;">
                    <strong>N:</strong> <%= data.estacion.coordenada_norte || '-' %><br>
                    <strong>E:</strong> <%= data.estacion.coordenada_este || '-' %>
                </td>
            </tr>
            <tr>
                <td class="lbl-tech">MUNICIPIO:</td>
                <td class="val-tech"><%= data.estacion.municipio || 'N/A' %></td>
                <td class="lbl-tech">COORDENADAS GPS:</td>
                <td class="val-tech text-center" style="font-family: monospace;"><%= data.estacion.coordenada_gps || '-' %></td>
            </tr>
            <tr>
                <td class="lbl-tech">COTA DE LA ESTACIÓN DE BOMBEO:</td>
                <td class="val-tech"><%= data.estacion.cota ? data.estacion.cota + ' M.S.N.M.' : '-' %></td>
                <td class="lbl-tech">POBLACION BENEFICIADA (HAB):</td>
                <td class="val-tech status-highlight">
                    <%= data.estacion.poblacion_bene !== null ? data.estacion.poblacion_bene.toLocaleString('es-ES') + ' HAB.' : '0 HAB.' %>
                </td>
            </tr> 
            <tr>
                <td colspan="4" class="section-divider">PARÁMETROS OPERATIVOS Y CAPACIDAD LOGÍSTICA</td>
            </tr>
            <tr>
                <td class="lbl-tech">CAUDAL DE DISEÑO DEL PROYECTO:</td>
                <td class="val-tech status-highlight"><%= data.estacion.caudal_diseño || '-' %> L/S</td>
                <td class="lbl-tech">CAUDAL DE DISEÑO A LA SALIDA:</td>
                <td class="val-tech"><%= data.estacion.caudal_diseño_salida !== null ? data.estacion.caudal_diseño_salida + ' L/S' : '-' %></td>
            </tr>
            <tr>
                <td class="lbl-tech">CAUDAL DE DISEÑO ENTRADA:</td>
                <td class="val-tech"><%= data.estacion.caudal_diseño_entrada !== null ? data.estacion.caudal_diseño_entrada + ' L/S' : '-' %></td>
                <td class="lbl-tech">CONSUMO EN (KW):</td>
                <td class="val-tech status-highlight"><%= data.estacion.consumo !== null ? data.estacion.consumo + ' KW' : '-' %></td>
            </tr>
            <tr>
                <td class="lbl-tech">CAUDAL ACTUAL DE OPERACIÓN:</td>
                <td class="val-tech status-positive"><%= data.estacion.caudal_operacion !== null ? data.estacion.caudal_operacion + ' L/S' : '-' %></td>
                <td class="lbl-tech">LÍNEA DE BOMBEO:</td>
                <td class="val-tech"><%= data.estacion.linea_bombeo !== null ? 'Línea ' + data.estacion.linea_bombeo : '-' %></td>
            </tr>
            <tr>
                <td class="lbl-tech">ADUCCIÓN A LA ESTACIÓN:</td>
                <td class="val-tech text-center status-highlight">
                    <%= data.estacion.aduccion === 0 ? 'GRAVEDAD (X)' : (data.estacion.aduccion === 1 ? 'BOMBEO (X)' : '-') %>
                </td>
                <td class="lbl-tech">GRUPO DE BOMBEO:</td>
                <td class="val-tech"><%= data.estacion.grupo_bombeo !== null ? 'Grupo ' + data.estacion.grupo_bombeo : '-' %></td>
            </tr>
            <tr>
                <td class="lbl-tech">SISTEMA DE BOMBEO:</td>
                <td class="val-tech text-center status-highlight">
                    <%= data.estacion.sistema_bombeo === 1 ? 'PARALELO (X)' : (data.estacion.sistema_bombeo === 0 ? 'SERIE (X)' : '-') %>
                </td>
                <td class="val-tech text-right matrix-footer-text" style="background-color: #f8fafc; font-size: 7.5pt; color: #64748b; font-style: italic;">
                    Control Técnico e Inspección.
                </td>
            </tr>
        </table>
        <footer class="footer-note">
            <div>Ficha Técnica de Control Interno</div>
            <div>Fecha de emisión: <%= fechaReporte %></div>
        </footer>
    </div>

    <% if (data.lineas_bombeo && data.lineas_bombeo.length > 0) { %>
        <% data.lineas_bombeo.forEach((linea, index) => { %>
        <div class="page-station">
            <%- renderHeader(2, 8) %>
            <table class="data-table">
                <tr>
                    <td colspan="4" class="section-divider">LINEA DE BOMBEO Nº<%= index + 1 %></td>
                </tr>
            </table>
            <table class="data-table">
                <colgroup>
                    <col style="width: 35%;">
                    <col style="width: 15%;">
                    <col style="width: 35%;">
                    <col style="width: 15%;">
                </colgroup>

                <tr>
                    <td class="lbl-tech">NUMEROS DE LINEAS DE BOMBEO Nº:</td>
                    <td colspan="3" class="val-tech status-highlight" style="font-size: 10.5pt;">
                        <%= linea.numero_linea || 'NO ESPECIFICADO' %>
                    </td>
                </tr>
                <tr>
                    <td class="lbl-tech">NOMBRE DE LINEA DE BOMBEO</td>
                    <td colspan="3" class="val-tech status-highlight" style="font-size: 10.5pt;">
                        <%= linea.nombre_linea_bombeo %>
                    </td>
                </tr>
                <tr>
                    <td class="lbl-tech">ESTADO DE LINEA DE BOMBEO</td>
                    <td colspan="3" class="val-tech status-highlight" style="font-size: 10.5pt;">
                        <%= linea.estado_linea_bombeo || '1' %>
                    </td>
                </tr>
                <tr>
                    <td class="lbl-tech">OBSERVACIONES DE LA LINEA DE BOMBEO</td>
                    <td colspan="3" class="val-tech status-highlight" style="font-size: 10.5pt;">
                        <%= linea.observaciones_linea_bombeo || '-' %>
                    </td>
                </tr>
                
            </table>
            <footer class="footer-note"><div>Registro de Equipos de Impulsión</div></footer>
        </div>
        <% }) %>
    <% } %>

    <% if (data.bombas && data.bombas.length > 0) { %>
        <% data.bombas.forEach((bomba, index) => { %>
        <div class="page-station">
            <%- renderHeader(3, 8) %>
            <table class="data-table">
                <tr>
                    <td colspan="4" class="section-divider">BOMBA Nº<%= index + 1 %></td>
                </tr>
            </table>
            <table class="data-table">
                <colgroup>
                    <col style="width: 35%;">
                    <col style="width: 15%;">
                    <col style="width: 35%;">
                    <col style="width: 15%;">
                </colgroup>

                <tr>
                    <td class="lbl-tech" style="background-color: #003366;">LINEA DE BOMBEO Nº:</td>
                    <td colspan="3" class="val-tech status-highlight" style="font-size: 10.5pt;">
                        <%= bomba.numero_linea || 'NO ESPECIFICADO' %>
                    </td>
                </tr>
                <tr>
                    <td class="lbl-tech">MODELO</td>
                    <td class="val-tech"><%= bomba.modelo_bomba %></td>
                    <td class="lbl-tech">MARCA</td>
                    <td class="val-tech"><%= bomba.marca_bomba || '-' %></td>
                </tr>
                <tr>
                    <td class="lbl-tech">TIPO</td>
                    <td class="val-tech"><%= bomba.tipo_bomba || '-' %></td>
                    <td class="lbl-tech">Q  (L/SEG)</td>
                    <td class="val-tech"><%= bomba.q ? bomba.q + ' L/SEG' : '-' %></td>
                </tr>
                <tr>
                    <td colspan="4" class="section-divider">ESPECIFICACIONES TÉCNICAS DE LA BOMBA Nº<%= index + 1 %></td>
                </tr>
                <tr>
                    <td class="lbl-tech">1 - No. ETAPA</td>
                    <td class="val-tech"><%= bomba.num_etapa || '-' %></td>
                    <td class="lbl-tech">2 - POTENCIA NOMINAL DE LA BOMBA (HP)</td>
                    <td class="val-tech"><%= bomba.pot_nom_bomba_hp ? bomba.pot_nom_bomba_hp + ' HP' : '-' %></td>
                </tr>
                <tr>
                    <td class="lbl-tech">3 - PRESIÓN DESCARGA (P.S.I.)</td>
                    <td class="val-tech"><%= bomba.presion_descarga ? bomba.presion_descarga + ' P.S.I.' : '-' %></td>
                    <td class="lbl-tech">4 - ALTURA DE ELEVACIÓN DE LA BOMBA (H) (M)</td>
                    <td class="val-tech"><%= bomba.alt_elevacion_bomba ? bomba.alt_elevacion_bomba + ' H M' : '-' %></td>
                </tr>
                <tr>
                    <td class="lbl-tech">5 - VELOCIDAD NOMINAL DE LA BOMBA (RPM)</td>
                    <td class="val-tech"><%= bomba.vel_nom_bomba_rpm ? bomba.vel_nom_bomba_rpm + ' RPM' : '-' %></td>
                    <td class="lbl-tech">6 - DIMENSIONES DEL IMPULSOR</td>
                    <td class="val-tech"><%= bomba.dimensiones_impulsor || '-' %></td>
                </tr>
                <tr>
                    <td class="lbl-tech">7 - DIAMETRO DE SUCCIÓN. (D)</td>
                    <td class="val-tech"><%= bomba.diametro_succion ? bomba.diametro_succion + ' D' : '-' %></td>
                    <td class="lbl-tech">8 - DIAMETRO DE DESCARGA. (D)</td>
                    <td class="val-tech"><%= bomba.diametro_carga ? bomba.diametro_carga + ' D' : '-' %></td>
                </tr>
                <tr>
                    <td class="lbl-tech">9 - PESO DE LA BOMBA</td>
                    <td class="val-tech"><%= bomba.peso_bomba || '-' %></td>
                    <td class="lbl-tech">10 - ACOPLAMIENTO</td>
                    <td class="val-tech">
                        <%=bomba.acomplamiento === 0 ? 'NO' : (bomba.acomplamiento === 1 ? 'SI' : '-')%>
                    </td>
                </tr>
                <tr>
                    <td class="lbl-tech">11 - TIPO DE ACOPLE</td>
                    <td class="val-tech"><%= bomba.tipo_acople || '-' %></td>
                    <td class="lbl-tech">12 - TIPO DE CABEZAL</td>
                    <td class="val-tech"><%= bomba.tipo_cabezal || '-' %></td>
                </tr>
                <tr>
                    <td class="lbl-tech">13 - DIAMETRO DE SUCCIÓN DEL CABEZAL. (D)</td>
                    <td class="val-tech"><%= bomba.diametro_succion_cabezal ? bomba.diametro_succion_cabezal + ' D' : '-' %></td>
                    <td class="lbl-tech">14 - DIAMETRO DE DESCARGA DEL CABEZAL. (D)</td>
                    <td class="val-tech"><%= bomba.diametro_descarga_cabezal ? bomba.diametro_descarga_cabezal + ' D' : '-' %></td>
                </tr>
                <tr>
                    <td class="lbl-tech">15 - LUBRICACIÓN</td>
                    <td class="val-tech">
                        <%=bomba.lubricacion === 0 ? 'NO' : (bomba.lubricacion === 1 ? 'SI' : '-')%>
                    </td>
                    <td class="lbl-tech">16 - RODAMIENTO / COJINETE</td>
                    <td class="val-tech">
                        <%= bomba.rodamiento === 0 ? 'NO' : (bomba.rodamiento === 1 ? 'SI' : '-')%>
                    </td>
                </tr>
            </table>
            <footer class="footer-note"><div>Registro de Equipos de Impulsión</div></footer>
        </div>
        <% }) %>
    <% } %>

    <% if (data.motores && data.motores.length > 0) { %>
        <% data.motores.forEach((motor, index) => { %>
        <div class="page-station">
            <%- renderHeader(4, 8) %>
            <table class="data-table">
                <tr><td colspan="4" class="section-divider">MOTOR Nº<%= index + 1 %></td></tr>                             
                </tr>
            </table>
            
            <table class="data-table">
                <colgroup>
                    <col style="width: 35%;">
                    <col style="width: 15%;">
                    <col style="width: 35%;">
                    <col style="width: 15%;">
                </colgroup>
                <tr>
                    <td class="lbl-tech" style="background-color: #003366;">LÍNEA DE BOMBEO Nº</td>
                    <td colspan="3" class="val-tech status-highlight" style="font-size: 10.5pt;">
                        <%= motor.numero_linea || '-' %>
                    </td>
                </tr>
                <tr>
                    <td class="lbl-tech">CÓDIGO DEL MOTOR (SERIE)</td>
                    <td class="val-tech"><%= motor.codigo_motor || 'N/C' %></td>
                    <td class="lbl-tech">MARCA (FABRICANTE)</td>
                    <td class="val-tech"><%= motor.marca_motor || '-' %></td>
                </tr>
                <tr>
                    <td class="lbl-tech">CORRIENTE CONTINUA</td>
                    <td class="val-tech">
                        <%= motor.tipo_corriente === 0 ? '(X)' : '-' %>
                    </td>
                    <td class="lbl-tech">CORRIENTE ALTERNA</td>
                    <td class="val-tech">
                        <%= motor.tipo_corriente === 1 ? '(X)' : '-' %>
                    </td>
                </tr>
                <% if (motor && motor.tipo_corriente === 1) { %>
                    <tr>
                    <td colspan="4" class="section-divider">ESPECIFICACIONES DE LA CORRIENTE ALTERNA</td>
                    </tr>
                    <tr>
                        <td class="lbl-tech">MONOFÁSICO</td>
                        <td class="val-tech">
                            <%= motor.mono_tri === 0 ? '(X)' : '-' %>
                        </td>
                        <td class="lbl-tech">TRIFÁSICO</td>
                        <td class="val-tech">
                            <%= motor.mono_tri === 1 ? '(X)' : '-' %>
                        </td>
                    </tr>
                    <tr>
                        <td class="lbl-tech">ASINCRONICO</td>
                        <td class="val-tech">
                            <%= motor.asin_sin === 0 ? '(X)' : '-' %>
                        </td>
                        <td class="lbl-tech">SINCRONICO</td>
                        <td class="val-tech">
                            <%= motor.asin_sin === 1 ? '(X)' : '-' %>
                        </td>
                    </tr>
                    <tr>
                        <td class="lbl-tech">UNIVERSAL</td>
                        <td class="val-tech">
                            <%= motor.universal === 1 ? '(SI)' : '-' %>
                        </td>
                        <td class="lbl-tech">SOPORTES TECNICOS</td>
                        <td class="val-tech">
                            <%= motor.soporte_tec === 1 ? '(SI)' : '-' %>
                        </td>
                    </tr>
                <% } %>
                <tr>
                    <td colspan="4" class="section-divider">ESPECIFICACIONES TÉCNICAS DEL MOTOR Nº<%= index + 1 %></td>
                </tr>
                <tr>
                    <td class="lbl-tech">1 - MODELO (TIPO)</td>
                    <td class="val-tech"><%= motor.tipo_motor %></td>
                    <td class="lbl-tech">2 - POTENCIA NOMINAL (HP)</td>
                    <td class="val-tech"><%= motor.pot_nom_motor_hp ? motor.pot_nom_motor_hp + ' HP' : '-' %></td>
                </tr>
                <tr>
                    <td class="lbl-tech">3 - POTENCIA NOMINAL (KW)</td>
                    <td class="val-tech"><%= motor.pot_nom_motor_kw || '-' %></td>
                    <td class="lbl-tech">4 - TENSIÓN NOMINAL DE OPERACIÓN (V)</td>
                    <td class="val-tech"><%= motor.tens_nom_operacion_v ? motor.tens_nom_operacion_v + ' V' : '-' %></td>
                </tr>
                <tr>
                    <td class="lbl-tech">5 - CORRIENTE NOMINAL (AMP)</td>
                    <td class="val-tech"><%= motor.tens_nom_operacion_amp ? motor.tens_nom_operacion_amp + ' AMP' : '-' %></td>
                    <td class="lbl-tech">6 - NÚMERO DE FASES</td>
                    <td class="val-tech"><%= motor.num_fases || '-' %></td>
                </tr>
                <tr>
                    <td class="lbl-tech">7 - EFICIENCIA (%)</td>
                    <td class="val-tech"><%= motor.eficencia ? motor.eficencia + ' %' : '-' %></td>
