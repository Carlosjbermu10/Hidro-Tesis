        </div>
        <% }) %>
    <% } %>

    <% if (data.generadores && data.generadores.length > 0) { %>
    <% data.generadores.forEach((gen, index) => { %>
        <% if (index > 0) { %>
            <div style="page-break-before: always;"></div>
        <% } %>   
            <%- renderHeader(8, 8) %>

            <table class="data-table">
                <tr>
                    <td colspan="4" class="section-divider">
                        GENERADOR N° <%= index + 1 %> - (PLANTA ELÉCTRICA) ESPECIFICACIONES TÉCNICAS
                    </td>
                </tr>
                <tr>
                    <td class="lbl-tech">POTENCIA PRINCIPAL (KW / KVA)</td>
                    <td class="val-tech"><%= gen.potencia_principal || '-' %></td>
                    <td class="lbl-tech">REVOLUCIÓN (RPM)</td>
                    <td class="val-tech"><%= gen.revolucion || '-' %></td>
                </tr>
                <tr>
                    <td class="lbl-tech">VOLTAJE (VOLTS)</td>
                    <td class="val-tech"><%= gen.voltaje || '-' %></td>
                    <td class="lbl-tech">FASE</td>
                    <td class="val-tech"><%= gen.fase || '-' %></td>
                </tr>
                <tr>
                    <td class="lbl-tech">CABLEADO</td>
                    <td class="val-tech"><%= gen.cableado || '-' %></td>
                    <td class="lbl-tech">FACTOR DE POTENCIA</td>
                    <td class="val-tech"><%= gen.factor_potencia || '-' %></td>
                </tr>
                <tr>
                    <td class="lbl-tech">CORRIENTE (AMP)</td>
                    <td class="val-tech"><%= gen.corriente || '-' %></td>
                    <td class="lbl-tech">CONEXIÓN</td>
                    <td class="val-tech"><%= gen.conexion || '-' %></td>
                </tr>
                <tr>
                    <td class="lbl-tech">FRECUENCIA</td>
                    <td class="val-tech"><%= gen.frecuencia || '-' %> Hz</td>
                    <td class="lbl-tech">RODAMIENTO</td>
                    <td class="val-tech"><%= gen.rodamiento || '-' %></td>
                </tr>
                <tr>
                    <td class="lbl-tech">CLASE DE PROTECCIÓN</td>
                    <td class="val-tech"><%= gen.clase_proteccion || '-' %></td>
                    <td class="lbl-tech">CLASE DE AISLAMIENTO</td>
                    <td class="val-tech"><%= gen.clase_aislamiento || '-' %>°C</td>
                </tr>
            </table>

            <table class="data-table" style="margin-top: 10px;">
                <tr>
                    <td colspan="4" class="section-divider">DATOS GENERALES DEL MOTOR</td>
                </tr>
                <tr>
                    <td class="lbl-tech">MODELO DEL MOTOR</td>
                    <td class="val-tech"><%= gen.modelo || '-' %></td>
                    <td class="lbl-tech">MARCA</td>
                    <td class="val-tech"><%= gen.marca || '-' %></td>
                </tr>
                <tr>
                    <td class="lbl-tech">ASPIRACIÓN</td>
                    <td class="val-tech"><%= gen.aspiracion || '-' %></td>
                    <td class="lbl-tech">REFRIGERACIÓN</td>
                    <td class="val-tech"><%= gen.refrigeracion === 1 ? 'Por Agua / Radiador' : (gen.refrigeracion || '-') %></td>
                </tr>
                <tr>
                    <td class="lbl-tech">N° DE CILINDROS</td>
                    <td class="val-tech"><%= gen.num_cilindros || '-' %></td>
                    <td class="lbl-tech">DISPOSICIÓN DE CILINDROS</td>
                    <td class="val-tech"><%= gen.disposicion_cilindros || 'En V' %></td>
                </tr>
                <tr>
                    <td class="lbl-tech">CILINDRADAS (C.C.)</td>
                    <td class="val-tech"><%= gen.cilindradas || '-' %></td>
                    <td class="lbl-tech">POTENCIA DEL MOTOR</td>
                    <td class="val-tech"><%= gen.potencia_motor || '-' %> HP</td>
                </tr>
                <tr>
                    <td class="lbl-tech">VELOCIDAD NOMINAL</td>
                    <td class="val-tech"><%= gen.velocidad_nominal || '-' %> RPM</td>
                    <td class="lbl-tech">TIPO DE REGULACIÓN</td>
                    <td class="val-tech"><%= gen.tipo_regulacion || '-' %></td>
                </tr>
                <tr>
                    <td class="lbl-tech">SISTEMA DE ARRANQUE</td>
                    <td class="val-tech"><%= gen.sistema_arranque || '-' %></td>
                    <td class="lbl-tech">CIRCUITO ELÉCTRICO (V)</td>
                    <td class="val-tech"><%= gen.circuito_electrico || '-' %> VCC</td>
                </tr>
                <tr>
                    <td class="lbl-tech">REGULADOR DE VELOCIDAD</td>
                    <td class="val-tech"><%= gen.regulador_velocidad === 1 ? 'Electrónico' : (gen.regulador_velocidad || '-') %></td>
                    <td class="lbl-tech">COMBUSTIBLE</td>
                    <td class="val-tech"><%= gen.combistible === 1 ? 'Diésel' : (gen.combistible || '-') %></td>
                </tr>
            </table>

            <table class="data-table" style="margin-top: 10px;">
                <tr>
                    <td colspan="4" class="section-divider">DATOS SOBRE EL CONSUMO DE COMBUSTIBLE Y LUBRICANTE</td>
                </tr>
                <tr>
                    <td class="lbl-tech">CONSUMO DE COMBUSTIBLE (L/H)</td>
                    <td class="val-tech"><%= gen.consumo_combustible || '-' %></td>
                    <td class="lbl-tech">CAPACIDAD DE ACEITE LUBRICANTE (L)</td>
                    <td class="val-tech"><%= gen.cap_aceite_lubricante || '-' %></td>
                </tr>
                <tr>
                    <td class="lbl-tech">CONSUMO DE LUBRICANTE (L/H)</td>
                    <td class="val-tech"><%= gen.consumo_lubricante || '-' %></td>
                    <td class="lbl-tech">TIPO DE LUBRICANTE</td>
                    <td class="val-tech"><%= gen.tipo_lubricante || '-' %></td>
                </tr>
            </table>

            <table class="data-table" style="margin-top: 10px;">
                <tr>
                    <td colspan="4" class="section-divider">DIMENSIÓN Y PESO</td>
                </tr>
                <tr>
                    <td class="lbl-tech">LARGO (MM)</td>
                    <td class="val-tech"><%= gen.largo ? (gen.largo * 1000) : '-' %></td>
                    <td class="lbl-tech">ANCHO (MM)</td>
                    <td class="val-tech"><%= gen.ancho ? (gen.ancho * 1000) : '-' %></td>
                </tr>
                <tr>
                    <td class="lbl-tech">ALTO (MM)</td>
                    <td class="val-tech"><%= gen.alto ? (gen.alto * 1000) : '-' %></td>
                    <td class="lbl-tech">PESO (EN SECO) (KG)</td>
                    <td class="val-tech"><%= gen.peso || '-' %></td>
                </tr>
                <tr>
                    <td class="lbl-tech">CAP. DEPÓSITO COMBUSTIBLE PROPIO (LTS)</td>
                    <td class="val-tech"><%= gen.cap_deposito_combustible_propio || '-' %></td>
                    <td class="lbl-tech">AUTONOMÍA</td>
                    <td class="val-tech"><%= gen.autonomia ? gen.autonomia + ' Horas' : '-' %></td>
                </tr>
            </table>

            <% 
                // Buscamos los tanques enlazados a este generador específico
                let tanquesAsociados = gen.interconexiones || data.interconexiones || []; 
            %>
            <% if (tanquesAsociados && tanquesAsociados.length > 0) { %>
                <% tanquesAsociados.forEach((tanque, tIndex) => { %>
                    <table class="data-table" style="margin-top: 10px;">
                        <tr>
                            <td colspan="4" class="section-divider">
                                ALMACENAMIENTO DE COMBUSTIBLE ASOCIADO (TANQUE N° <%= tIndex + 1 %>)
                            </td>
                        </tr>
                        <tr>
                            <td class="lbl-tech">VOLUMEN DEL TANQUE</td>
                            <td class="val-tech"><%= tanque.volumen || '-' %> Lts</td>
                            <td class="lbl-tech">GEOMETRÍA DEL TANQUE</td>
                            <td class="val-tech"><%= tanque.geometria === 1 ? 'Cilíndrico' : (tanque.geometria || '-') %></td>
                        </tr>
                        <tr>
                            <td class="lbl-tech">POSICIÓN DEL TANQUE</td>
                            <td class="val-tech"><%= tanque.posicion || '-' %></td>
                            <td class="lbl-tech">MATERIAL DEL TANQUE</td>
                            <td class="val-tech"><%= tanque.material_tanque || '-' %></td>
                        </tr>
                        <tr>
                            <td class="lbl-tech">DIMENSIONES DEL DIQUE</td>
                            <td class="val-tech">L: <%= tanque.largo || '-' %>m | A: <%= tanque.ancho || '-' %>m | Esp: <%= tanque.espesor || '-' %>m</td>
                            <td class="lbl-tech">CAPACIDAD MÁXIMA / TOTAL LITROS</td>
                            <td class="val-tech"><%= tanque.cap_max_tanque || '-' %> / <%= tanque.total_litros || '-' %> Lts</td>
                        </tr>
                        <tr>
                            <td class="lbl-tech">TIENE EXTINTORES</td>
                            <td class="val-tech text-center" style="font-weight: bold;">
                                SI [ <%= tanque.extintor === 1 ? 'X' : ' ' %> ] &nbsp;&nbsp;&nbsp;&nbsp; NO [ <%= tanque.extintor === 0 ? 'X' : ' ' %> ]
                            </td>
                            <td class="lbl-tech">ÁREA CERCADA / CERRAMIENTO</td>
                            <td class="val-tech"><%= tanque.area_cercada === 1 ? 'SI (' + tanque.tipo_cerramiento + ')' : 'NO' %></td>
                        </tr>
                        
                        <tr>
                            <td colspan="4" style="background-color: #f8f9fa; text-align: center; font-weight: bold; font-size: 10px; color: #333; letter-spacing: 0.5px; border-top: 1px dashed #ccc;">
                                ESPECIFICACIONES DE LA LÍNEA DE ALIMENTACIÓN (INTERCONEXIÓN)
                            </td>
                        </tr>
                        <tr>
                            <td class="lbl-tech">TIPO DE SUMINISTRO</td>
                            <td class="val-tech"><%= tanque.tipo_suministro || '-' %></td>
                            <td class="lbl-tech">DIÁMETRO DE TUBERÍA</td>
                            <td class="val-tech"><%= tanque.diametro_tuberia ? tanque.diametro_tuberia + ' pulg' : '-' %></td>
                        </tr>
                        <tr>
                            <td class="lbl-tech">LONGITUD DE LA LÍNEA</td>
                            <td class="val-tech"><%= tanque.longitud_linea ? tanque.longitud_linea + ' metros' : '-' %></td>
                            <td class="lbl-tech">ESTADO DE INTERCONEXIÓN</td>
                            <td class="val-tech" style="font-weight: bold; color: green;">OPERATIVO</td>
                        </tr>
                    </table>
                <% }) %>
            <% } else { %>
                <table class="data-table" style="margin-top: 10px;">
                    <tr>
                        <td colspan="4" class="section-divider">ALMACENAMIENTO DE COMBUSTIBLE</td>
                    </tr>
                    <tr>
                        <td colspan="4" class="val-tech text-center">No se registran tanques de almacenamiento externos vinculados a este generador.</td>
                    </tr>
                </table>
            <% } %>

            <footer class="footer-note">
                <div>Registro de Respaldo Energético y Sistema de Interconexión de Combustible - Control Institucional</div>
            </footer>
        </div>
    <% }) %>
    <% } %>

</body>
</html>